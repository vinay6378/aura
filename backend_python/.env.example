# Security Configuration
JWT_SECRET_KEY=your_super_secure_jwt_secret_key_change_this_in_production
DATABASE_URL=aura.db

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://auraofficial.in

# Google Analytics 4 Configuration
GA4_PROPERTY_ID=your_ga4_property_id
GA4_CREDENTIALS_PATH=path/to/service-account.json

# Automation Webhooks
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/contact
GUMLOOP_WEBHOOK_URL=https://your-gumloop-instance.com/webhook/email

# Environment
FLASK_ENV=production
